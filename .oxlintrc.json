{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["node_modules", "dist", "tests/gate/canary.txt", ".claude/skills", ".codex"],
  "overrides": [
    {
      "files": ["tests/surfaces/receipt-read-refusal-does-not-claim-no-effect.test.tsx"],
      "rules": { "require-await": "off", "no-promise-executor-return": "off" }
    },
    { "files": ["tests/review/sl01-s06-proof.test.ts"], "rules": { "no-await-in-loop": "off" } },
    {
      "files": [
        "tests/commands/parity-rejects-direct-ui-write.test.ts",
        "tests/commands/direct-entry-write-parity.test.ts",
        "tests/commands/commented-sign-in-parity.test.ts"
      ],
      "rules": { "no-inline-comments": "off" }
    },
    {
      "files": [
        "tests/api/live-board-closed-recheck-review.test.ts",
        "tests/api/live-board-scoped-revocation-review.test.ts",
        "tests/api/live-board-client-move-review.test.ts",
        "tests/api/live-board-revoked-during-rejoin-review.test.ts",
        "tests/api/live-task-admitted-during-close-review.test.ts",
        "tests/api/live-board-revoked-after-final-read-review.test.ts",
        "tests/api/live-board-client-move-prompt-review.test.ts",
        "tests/api/live-board-task-resync-isolation-review.test.ts",
        "tests/api/live-task-frame-no-identifier-review.test.ts",
        "tests/ci/inb1f-rebind-mutation-review.test.ts"
      ],
      "rules": {
        "no-inline-comments": "off",
        "no-await-in-loop": "off",
        "unicorn/consistent-function-scoping": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["tests/api/live-board-lost-access.test.ts"],
      "rules": {
        "no-await-in-loop": "off",
        "unicorn/no-immediate-mutation": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["tests/ci/staging-special-objects.test.ts"],
      "rules": { "max-lines-per-function": "off" }
    },
    {
      "files": ["tests/ci/t2f-unwire-keeps-live-board-running.test.mjs"],
      "rules": { "max-lines-per-function": "off" }
    },
    {
      "files": ["tests/ci/staging-no-production-data-guard.test.ts"],
      "rules": {
        "no-await-in-loop": "off",
        "max-lines": "off",
        "max-lines-per-function": "off",
        "no-promise-executor-return": "off"
      }
    },
    {
      "files": [
        "tests/api/hosted-expired-lease-recovery.test.ts",
        "tests/ci/restore-includes-sign-in-tables.test.ts",
        "tests/ci/restore-includes-staging-guards.test.ts",
        "tests/api/hosted-recovery-waits-for-pass.test.ts",
        "tests/ci/staging-archive-restores-guards.test.ts"
      ],
      "rules": {
        "no-await-in-loop": "off",
        "no-inline-comments": "off",
        "no-promise-executor-return": "off",
        "max-lines-per-function": "off",
        "require-await": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
