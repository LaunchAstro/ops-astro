{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["node_modules", "dist", "tests/gate/canary.txt", ".claude/skills", ".codex"],
  "overrides": [
    { "files": ["tests/review/sl01-s06-proof.test.ts"], "rules": { "no-await-in-loop": "off" } },
    {
      "files": [
        "tests/api/live-board-closed-recheck-review.test.ts",
        "tests/api/live-board-scoped-revocation-review.test.ts",
        "tests/api/live-board-client-move-review.test.ts",
        "tests/api/live-board-revoked-during-rejoin-review.test.ts",
        "tests/api/live-task-admitted-during-close-review.test.ts",
        "tests/api/live-board-revoked-after-final-read-review.test.ts"
      ],
      "rules": {
        "no-await-in-loop": "off",
        "unicorn/consistent-function-scoping": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["tests/api/live-board-lost-access.test.ts"],
      "rules": {
        "no-await-in-loop": "off",
        "unicorn/no-immediate-mutation": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["tests/ci/staging-special-objects.test.ts"],
      "rules": { "max-lines-per-function": "off" }
    },
    {
      "files": ["tests/ci/t2f-unwire-keeps-live-board-running.test.mjs"],
      "rules": { "max-lines-per-function": "off" }
    },
    {
      "files": ["tests/ci/staging-no-production-data-guard.test.ts"],
      "rules": {
        "no-await-in-loop": "off",
        "max-lines": "off",
        "max-lines-per-function": "off",
        "no-promise-executor-return": "off"
      }
    }
  ]
}
