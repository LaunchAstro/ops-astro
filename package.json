{
  "name": "@launchastro/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pre-alpha organisational system foundation, carrying a local task slice that runs on one machine against a real local Postgres. Nothing is deployed or released.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "oxlint",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:baseline": "node scripts/lint-ratchet.mjs --write",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:diff": "node scripts/token-diff.mjs",
    "type:census": "node scripts/type-census.mjs",
    "build": "node scripts/build.mjs",
    "brand:check": "node scripts/product-name.mjs --check",
    "brand:sync": "node scripts/product-name.mjs --write",
    "brand:cases": "node --test tests/branding/product-name-cases.mjs",
    "review:preflight": "node scripts/review-preflight.mjs",
    "gate:selftest": "python3 scripts/gate/sweep.py --self-test",
    "gate": "python3 scripts/gate/sweep.py",
    "gate:cases": "bash tests/gate/gate-cases.sh",
    "gate:hooks": "bash tests/gate/hook-exit-cases.sh",
    "commits:cases": "bash tests/ci/commit-range-cases.sh",
    "migrations:unchanged": "node scripts/migrations-unchanged.mjs",
    "migrations:cases": "node --test tests/ci/migrations-unchanged-cases.mjs",
    "size:cases": "bash tests/ci/pr-size-cases.sh",
    "review:cases": "bash tests/ci/review-evidence-cases.sh",
    "session:cases": "bash tests/agents/session-check-cases.sh",
    "receipt": "bash scripts/publication-receipt.sh",
    "pins": "node scripts/pins-check.mjs",
    "pins:cases": "bash tests/ci/pins-check-cases.sh",
    "skills:refs": "node scripts/skill-refs-check.mjs",
    "merge:policy": "node scripts/merge-policy-check.mjs",
    "gate:range": "python3 scripts/gate/sweep.py --range",
    "gate:literal": "python3 scripts/gate/sweep.py --literal",
    "licences": "node scripts/licences/check.mjs",
    "licences:cases": "bash tests/licences/licence-cases.sh",
    "check": "node scripts/check.mjs",
    "prepare": "husky",
    "provenance:cases": "node --test tests/ci/provenance-cases.mjs",
    "candidate:cases": "node --test tests/ci/candidate-cases.mjs",
    "candidate:snapshot": "node scripts/candidate-snapshot.mjs",
    "public:content": "node scripts/public-content-check.mjs",
    "public:content:tree": "node scripts/public-content-check.mjs --repo .",
    "secrets": "node scripts/secrets-scan.mjs",
    "public:history:cases": "node --test tests/ci/public-history-cases.mjs",
    "spdx": "node scripts/spdx-check.mjs",
    "spdx:cases": "node --test tests/licences/spdx-cases.mjs",
    "deps:cruise": "node scripts/deps-cruise.mjs",
    "deps:cases": "node --test tests/ci/deps-cruise-cases.mjs tests/ci/db-shard-declaration-cruise.test.mjs",
    "db:conformance": "node scripts/db-conformance.mjs",
    "db:cases": "node --test tests/ci/db-conformance-cases.mjs tests/ci/docker-leak-cases.mjs",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "db:up": "bash scripts/local/db-up.sh",
    "db:down": "bash scripts/local/db-down.sh",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/local-seed.mjs",
    "fixture:snapshot": "bash scripts/local/fixture-snapshot.sh build",
    "fixture:clone": "bash scripts/local/fixture-snapshot.sh clone",
    "auth:up": "bash scripts/local/auth-up.sh",
    "auth:seed": "node scripts/local/auth-seed.mjs",
    "api:up": "bash scripts/local/api-up.sh",
    "web:up": "bash scripts/local/web-up.sh",
    "verify:slice": "node scripts/local/verify-slice.mjs",
    "test:api": "vitest run tests/api",
    "test:ten-runs": "node tests/ci/ten-green-runs.mjs",
    "build:web": "pnpm --filter @launchastro/web exec vite build",
    "verify:browser": "node tests/browser/slice-acceptance.mjs",
    "verify:d06-mounted": "node tests/browser/d06-mounted.mjs",
    "verify:restart": "bash scripts/local/restart-proof.sh",
    "verify:upgrade-drill": "node scripts/local/upgrade-drill.mjs",
    "verify:restart-legs": "node tests/browser/restart-legs.mjs",
    "verify:journey": "node scripts/local/journey.mjs",
    "verify:runtime-proofs": "bash scripts/local/runtime-proofs.sh",
    "cli": "node apps/cli/main.ts",
    "worker": "node apps/worker/main.ts",
    "forwarder": "node scripts/ops/forwarder.mjs",
    "verify:identity": "node scripts/local/identity-check.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.9"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@swc/core": "1.16.2",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "18.4.0",
    "husky": "9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "17.5.0",
    "markdown-it": "14.3.2",
    "oxlint": "1.81.0",
    "pg": "8.23.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
