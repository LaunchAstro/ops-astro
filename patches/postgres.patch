   async function begin(options, fn) {
     !fn && (fn = options, options = '')
     const queries = Queue()
+        // ops-astro #1774: `options` here is begin's mode; the refusal names the server from the pool's.
+        , refused = () => Errors.connection('CONNECTION_CLOSED', sql.options)
     let savepoints = 0
