{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "isolatedDeclarations": false,
    "paths": { "@launchastro/ui": ["./packages/ui/src/index.ts"] }
  },
  "include": [
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "packages/ui/**/*.ts",
    "packages/ui/**/*.tsx",
    "tests/surfaces/**/*.ts",
    "tests/surfaces/**/*.tsx",
    "tests/web/**/*.ts",
    "tests/web/**/*.tsx"
  ],
  // Sol's REVB1ENDSL01A proof is kept byte-for-byte as the review patch held it;
  // it reads `dataset.outcome`, which noPropertyAccessFromIndexSignature refuses.
  "exclude": ["**/node_modules", "**/dist", "tests/surfaces/run-progress-malformed-answer.test.tsx"]
}
