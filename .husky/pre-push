# The last check before anything becomes public.
#
# Husky runs this as `sh -e "$hook"` (.husky/_/h). Under `sh -e` a command
# that returns non-zero ends the script on the spot, so a hook that runs a
# scanner and then reads $? never reaches its own handling. That is exactly
# what happened to the first version of this file: the scanner's exit 2,
# which means "the private list is not on this machine", killed the hook
# instead of being handled by it. Every scanner call below is therefore
# captured inside an `if`, which `sh -e` does not treat as a failure.
#
# Exit codes from the scanner:
#   0  clean
#   1  contamination found          -> refuse the push
#   2  the private list is absent   -> only acceptable for the literal sweep
#   3  the gate is broken           -> refuse the push, always
#
# HUB_GATE_CMD exists so tests/gate/hook-exit-cases.sh can substitute a stub
# scanner and prove all four codes are handled. Leave it unset in real use.
#
# Each pushed commit is judged by the scanners in that commit, not by the
# checkout the push starts in. A stale checkout would refuse a clean push or
# pass what the pushed rules refuse, and a branch that changes a scanner would
# be judged by the old one. So the hook exports each pushed commit's scripts/
# and tests/gate/ (the self-test's canaries) and runs those, told by
# HUB_GATE_REPO which repository to read. Only a hand run, with no refs on
# stdin, uses the checkout's own scanners.

HUB_GATE_REPO=$PWD
export HUB_GATE_REPO
# A push sends the objects themselves, never a local `git replace` stand-in,
# so every Git read here and in the scanners ignores replacements: the
# exported scanners are the pushed commit's own.
GIT_NO_REPLACE_OBJECTS=1
export GIT_NO_REPLACE_OBJECTS
# Every commit's exported scanners sit in one scratch folder, removed whole
# and quoted, so a TMPDIR holding a space names nothing else.
scratch=""
trap '[ -z "$scratch" ] || rm -rf "$scratch"' EXIT

# Points the gate and public-content runs at one commit's scanners, or at
# the checkout's with no commit. A commit whose scanners cannot be read is
# refused: nothing is published unscanned.
use_scanners_of() {
  root=.
  if [ -n "$1" ] && { [ -z "${HUB_GATE_CMD:-}" ] || [ -z "${HUB_PUBLIC_CONTENT_CMD:-}" ]; }; then
    [ -n "$scratch" ] || scratch=$(mktemp -d "${TMPDIR:-/tmp}/pre-push-scanners.XXXXXX")
    root=$(mktemp -d "$scratch/commit.XXXXXX")
    if git archive -o "$root/scanners.tar" "$1" scripts tests/gate \
      && tar -xf "$root/scanners.tar" -C "$root"; then
      :
    else
      echo "pre-push: cannot read the scanners in $1. Refusing the push."
      exit 1
    fi
  fi
}

# The scanners at $root, their paths quoted; a stand-in command when set.
gate() {
  if [ -n "${HUB_GATE_CMD:-}" ]; then $HUB_GATE_CMD "$@"; else python3 "$root/scripts/gate/sweep.py" "$@"; fi
}
public_content() {
  if [ -n "${HUB_PUBLIC_CONTENT_CMD:-}" ]; then
    $HUB_PUBLIC_CONTENT_CMD "$@"
  else
    node "$root/scripts/public-content-check.mjs" "$@"
  fi
}

# Runs the gate and puts its exit code in $status. The `if` is what keeps
# `sh -e` from ending the hook on a non-zero exit, and it leaves the gate's
# own output on the terminal where a person can read it.
status=0
run_gate() {
  if gate "$@"; then
    status=0
  else
    status=$?
  fi
}

# Scans one range, or every commit not already on a remote when given none,
# with the scanners in hand. Any refusal ends the hook.
scan() {
  range=${1:-}
  # 1. Is the gate itself still working? A blind gate that has quietly
  #    stopped working looks exactly like a clean repository.
  run_gate --self-test
  if [ "$status" -ne 0 ]; then
    echo "pre-push: the gate's self-test failed (exit $status). The gate is broken."
    echo "pre-push: refusing the push. Nothing is scanned by a scanner that cannot"
    echo "pre-push: prove itself. Fix the gate, do not bypass this."
    exit 1
  fi

  # 2. Every blob in every outgoing commit, both sides of every change. This
  #    is the check a working-tree sweep cannot do: a file added and later
  #    deleted is still in the history you are about to publish.
  # shellcheck disable=SC2086
  run_gate --range $range
  case "$status" in
    0) ;;
    1)
      echo "pre-push: contamination in the commits you are about to publish."
      echo "pre-push: refusing the push. Rewrite the history, do not just delete"
      echo "pre-push: the file: the old blob stays reachable until you do."
      exit 1
      ;;
    *)
      echo "pre-push: the gate is broken (exit $status) and could not scan the"
      echo "pre-push: outgoing commits. Refusing the push."
      exit 1
      ;;
  esac

  # 3. The public-foundation policy also covers commit metadata and every
  #    historical blob/path. The test command override follows HUB_GATE_CMD.
  if [ -n "$range" ]; then
    set -- --range "$range"
  else
    set -- --outgoing
  fi
  if public_content --repo "$PWD" "$@"; then
    :
  else
    echo "pre-push: public-content history check failed. Refusing the push."
    exit 1
  fi

  # 4. The maintainer-only literal sweep. It needs the clear-text list, which
  #    lives outside git on a maintainer machine. Exit 2 there means it did
  #    not run, and that is allowed to pass: the hashed gate and the shape
  #    rules have already run above, and gitleaks runs in continuous
  #    integration. It reads the same revisions, not a different selection:
  #    giving --literal nothing sent it to every outgoing branch, so a
  #    contaminated backup branch could block a clean push of main and the
  #    two scanners could disagree about what was being published. Round
  #    four found it.
  # shellcheck disable=SC2086
  run_gate --literal $range
  case "$status" in
    0) ;;
    1)
      echo "pre-push: the literal sweep found contamination. Refusing the push."
      exit 1
      ;;
    2)
      echo "pre-push: the literal sweep did not run on this machine: the private"
      echo "pre-push: list is not here. Continuing. The hashed gate and the shape"
      echo "pre-push: rules have already run, and gitleaks runs in CI."
      ;;
    *)
      echo "pre-push: the literal sweep reported the gate is broken (exit $status)."
      echo "pre-push: Refusing the push."
      exit 1
      ;;
  esac
}

# Git hands a pre-push hook the refs being pushed on stdin, one per line:
# <local ref> <local sha> <remote ref> <remote sha>. Scan exactly those.
# Scanning every local branch instead would refuse a clean push because some
# unrelated local branch is dirty, and would say nothing about whether the
# branch you are actually publishing is clean. A backup branch kept before a
# history rewrite is the obvious case.
#
# An all-zero remote sha means the remote has no such branch yet, so the
# range is everything reachable from the local ref. That is the first-push
# case, and it is the one that matters most.
pushed=""
had_input=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  had_input=1
  case "$local_sha" in
    *[!0]*) ;;            # a real sha
    *) continue ;;        # all zeros: this is a deletion, nothing to scan
  esac
  case "$remote_sha" in
    *[!0]*) pushed="$pushed $local_sha:$remote_sha..$local_sha" ;;
    *) pushed="$pushed $local_sha:$local_sha" ;;
  esac
done

if [ -n "$pushed" ]; then
  # Each ref by its own commit's scanners, over its own range.
  for item in $pushed; do
    use_scanners_of "${item%%:*}"
    echo "pre-push: scanning what this push would publish: ${item#*:}"
    scan "${item#*:}"
  done
elif [ "$had_input" -eq 1 ]; then
  # A deletion is not the same as no input. With refs on stdin but nothing to
  # publish, there is nothing to scan, and falling back to every outgoing
  # branch would scan things this push does not touch.
  echo "pre-push: this push publishes no new commits. Nothing to scan."
else
  # No refs on stdin: someone ran the hook by hand. Fall back to every commit
  # not already on a remote, with the checkout's scanners.
  use_scanners_of ""
  scan
fi
exit 0
