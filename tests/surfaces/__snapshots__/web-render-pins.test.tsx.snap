due"><dt class="tf__k">Due date</dt><dd class="sb__state">2026-10-01</dd></div><div class="tf__row" data-field="estimate"><dt class="tf__k">Estimate</dt><dd class="sb__state">not set</dd></div><div class="tf__row" data-field="project"><dt class="tf__k">Project</dt><dd class="sb__state">not set</dd></div><div class="tf__row" data-field="category"><dt class="tf__k">Category</dt><dd class="sb__state">not set</dd></div><div class="tf__row" data-field="stage"><dt class="tf__k">Stage</dt><dd class="sb__state">not set</dd></div><div class="tf__row" data-field="status"><dt class="tf__k">Status</dt><dd class="sb__state">Active</dd></div><div class="tf__row" data-field="page-link"><dt class="tf__k">Page link</dt><dd class="sb__state">nothing yet</dd></div><div class="tf__row" data-field="handling"><dt class="tf__k">Handling</dt><dd class="sb__state">Neither ad hoc nor client-visible</dd></div></dl></section><button class="tt__more" type="button" data-panel-door="open" disabled="">Open this task in the panel</button><div class="tpr__perspectives" data-perspectives="true"><div class="cmtabs" role="tablist" aria-label="Team and agent views of this task" data-tabs="perspective"><button class="cmtab" type="button" role="tab" id="perspective-tab-team" aria-selected="true" aria-controls="perspective-panel-team" tabindex="0">Team</button><button class="cmtab" type="button" role="tab" id="perspective-tab-agent" aria-selected="false" aria-controls="perspective-panel-agent" tabindex="-1">Agent<span class="cbadge cbadge--plain" title="1 open gate waiting on you">1</span></button><span class="cmtabs__mark" aria-hidden="true"></span></div><div id="perspective-panel-team" role="tabpanel" aria-labelledby="perspective-tab-team" tabindex="0"><section class="sb__sect"><div class="sb__sh"><span class="sb__k">State</span></div><div class="btnrow"><button class="btn" type="button" data-lifecycle="start">Start</button><button class="btn" type="button" data-lifecycle="complete">Complete</button><button class="btn" type="button" data-lifecycle="reopen">Reopen</button></div></section><section class="sb__sect"><div class="sb__sh"><span class="sb__k">Assignee</span></div><div class="readstate" data-outcome="ready"><select class="input" aria-label="Assignee"><option value="">Unassigned</option><option value="p-1">Ada</option></select></div></section><form id="task-fields" class="sb__sect taskform"><div class="sb__sh"><span class="sb__k">Details</span></div><div class="field"><label class="tf__k" for="task-title">Title</label><input id="task-title" class="input" required="" type="text" value="A task with one proposal"></div><div class="field"><label class="tf__k" for="task-due">Due date</label><input id="task-due" class="input" type="date" value="2026-10-01"></div><button class="btn btn--primary" type="submit">Save changes</button></form><section class="sb__sect" data-writing="description"><div class="sb__sh"><span class="sb__k">Description</span></div><p class="sbempty">No description on this one yet.</p></section><section class="sb__sect" data-steps="true"><div class="sb__sh"><span class="sb__k">Subtasks</span></div><p class="card__sub">No subtasks on this one yet.</p><button class="tt__more" type="button" data-panel-door="add-first" disabled="">Add the first one in the task panel</button></section><section class="sb__sect" data-time="true"><div class="sb__sh"><span class="sb__k">Time</span></div><p class="card__sub">No time logged yet.</p><button class="tt__more" type="button" data-panel-door="log" disabled="">Log time in the task panel</button><button class="tt__more" type="button" data-panel-door="timer" disabled="">Start the timer in the task panel</button></section><section class="sb__sect" data-comments="section"><div class="sb__sh"><span class="sb__k">Comments</span><span class="sbact__meta">1 on this task</span></div><div class="cmtabs" role="tablist" aria-label="Who each part of the conversation is with" data-tabs="conversation"><button class="cmtab" type="button" role="tab" id="conversation-tab-internal" aria-selected="true" aria-controls="conversation-panel-internal" tabindex="0">Internal<span class="cbadge cbadge--plain" title="1 on this task">1</span></button><button class="cmtab" type="button" role="tab" id="conversation-tab-client" aria-selected="false" aria-controls="conversation-panel-client" tabindex="-1">Client</button><button class="cmtab" type="button" role="tab" id="conversation-tab-all" aria-selected="false" aria-controls="conversation-panel-all" tabindex="-1">All activity</button><span class="cmtabs__mark" aria-hidden="true"></span></div><div id="conversation-panel-internal" role="tabpanel" aria-labelledby="conversation-tab-internal" tabindex="0"><div class="thread" data-comments="list"><article class="msg msg--internal" data-comment-id="c-1" data-audience="internal"><div class="sbact__meta"><span class="sb__state" data-comment-audience="internal">Internal</span><span> · note</span><span> · p-1</span><span> · 2026-09-22T02:00:00.000Z</span></div><p class="card__body">First note</p></article></div></div><div id="conversation-panel-client" role="tabpanel" aria-labelledby="conversation-tab-client" tabindex="0" hidden=""></div><div id="conversation-panel-all" role="tabpanel" aria-labelledby="conversation-tab-all" tabindex="0" hidden=""></div><p class="field__error" role="alert" data-comment="refusal">SCOPE_NOT_GRANTED (task). Read the task again.</p><form id="task-comment" class="taskform"><div class="field"><label class="tf__k" for="comment-body">Say something</label><textarea id="comment-body" class="input" rows="3" required="" disabled="">Hello</textarea></div><button class="btn btn--primary" type="submit" data-comment="post" disabled="">Post comment</button><p class="card__sub" data-comment="closed">The server refused this. The box is closed rather than asking again on your behalf.</p></form><button class="tt__more" type="button" data-panel-door="reply" disabled="">Reply in the task panel</button></section><section class="sb__sect" data-history="true"><div class="sb__sh"><span class="sb__k">History</span><span class="sbact__meta" data-history="latest">7 days ago · p-1 · Created</span></div><div class="sbact" data-history="trail"><div class="sbact__row"><span class="sbact__meta">7 days ago · p-1</span><span class="sb__state">Created</span></div></div></section></div><div id="perspective-panel-agent" role="tabpanel" aria-labelledby="perspective-tab-agent" tabindex="0" hidden=""><section class="sb__sect" data-writing="brief"><div class="sb__sh"><span class="sb__k">Agent brief</span></div><p class="sbempty">No brief has been written for this task yet.</p></section><section class="sb__sect" data-proposals="section"><div class="sb__sh"><span class="sb__k">Proposals</span><span class="sbact__meta">1 on this task</span></div><div class="stack" data-proposals="list"><article class="sb__sect" data-lineage-id="l-1" data-lineage-state="live"><div class="sb__sh"><span class="sb__k">Lineage</span><span class="sb__state">live</span><span class="sbact__meta">l-1</span></div><div class="sb__sect" data-version="1" data-version-id="v-1" data-version-superseded="false"><div class="sb__sh"><span class="sb__k">Version 1</span><span class="sb__state">client_renewal_quote</span><span class="sbact__meta" data-version="ceiling">up to AUD 2,500.00</span></div><div class="card__sub"><span data-version="digest">payload digest digest-1</span></div><pre class="card__body" data-version="payload">{
  "step": "draft the quote"
}</pre><p class="card__sub" data-evidence="none">No evidence pack was stored against this version.</p><div class="card__sub" data-gate-expired="false" data-gate-state="pending">Gate pending, round 1<span> · expires 2026-09-23T05:00:00.000Z</span></div><div class="btnrow" data-decide="controls"><button class="btn btn--primary" data-decide="approve" data-gate-id="g-1" data-version-id="v-1" type="button">Approve this version</button><button class="btn" data-decide="reject" data-gate-id="g-1" data-version-id="v-1" type="button">Reject</button></div></div></article></div><form class="taskform" id="task-propose"><div class="sb__sh"><span class="sb__k">Propose something</span></div><div class="field"><label class="tf__k" for="propose-purpose">What it is for</label><input class="input" id="propose-purpose" pattern="[a-z][a-z0-9_]{0,62}" required="" title="Lower case, digits and underscores, starting with a letter." type="text" value=""><p class="card__sub">Lower case, digits and underscores, such as client_renewal_quote.</p></div><div class="field"><label class="tf__k" for="propose-maximum">The most it may spend</label><input class="input" id="propose-maximum" min="0" required="" step="0.01" type="number" value=""></div><div class="field"><label class="tf__k" for="propose-currency">In</label><select class="input" id="propose-currency"><option value="AUD">AUD</option></select></div><button class="btn btn--primary" data-propose="submit" type="submit">Propose</button></form></section></div></div></div></div></div>"
`;

