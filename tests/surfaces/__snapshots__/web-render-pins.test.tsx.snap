}</pre><p class="card__sub" data-evidence="none">No evidence pack was stored against this version.</p><div class="card__sub" data-gate-expired="false" data-gate-state="pending">Gate pending, round 1<span> · expires 2026-09-23T05:00:00.000Z</span></div><div class="btnrow" data-decide="controls"><button class="btn btn--primary" data-decide="approve" data-gate-id="g-1" data-version-id="v-1" type="button">Approve this version</button><button class="btn" data-decide="reject" data-gate-id="g-1" data-version-id="v-1" type="button">Reject</button></div></div></article></div><form class="taskform" id="task-propose"><div class="sb__sh"><span class="sb__k">Propose something</span></div><div class="field"><label class="tf__k" for="propose-purpose">What it is for</label><input class="input" id="propose-purpose" pattern="[a-z][a-z0-9_]{0,62}" required="" title="Lower case, digits and underscores, starting with a letter." type="text" value=""><p class="card__sub">Lower case, digits and underscores, such as client_renewal_quote.</p></div><div class="field"><label class="tf__k" for="propose-maximum">The most it may spend</label><input class="input" id="propose-maximum" min="0" required="" step="0.01" type="number" value=""></div><div class="field"><label class="tf__k" for="propose-currency">In</label><select class="input" id="propose-currency"><option value="AUD">AUD</option></select></div><button class="btn btn--primary" data-propose="submit" type="submit">Propose</button></form></section><section class="sb__sect"><div class="sb__sh"><span class="sb__k">History</span></div><div class="sbact"><div class="sbact__row"><span class="sbact__meta">2026-09-22T01:00:00.000Z · p-1</span><span class="sb__state">task.create</span></div></div></section></div></div></div>"
`;

