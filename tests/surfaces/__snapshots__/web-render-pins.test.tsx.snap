exports[`the task page, pinned whole > after a comment refused for want of the grant 1`] = `
"<div class="stack"><div class="btnrow"><button class="btn" type="button" data-refresh="task">Refresh</button></div><div class="readstate" data-outcome="ready"><div class="stack" data-task="44444444-4444-4444-8444-444444444444" data-revision="3"><header class="tpr"><div class="tpr__crumb"><a class="sb__addr" href="/projects/">Projects</a><span aria-hidden="true">›</span><span>No board</span><span class="sbact__meta">· TSK-41</span><span class="spill" data-tone="run" data-state-reference="new_behaviour">Active</span></div><h2 class="tpr__title">A task with one proposal</h2><div class="card__sub">Revision 3 · not completed</div></header><section class="sb__sect"><div class="sb__sh"><span class="sb__k">State</span></div><div class="btnrow"><button class="btn" type="button" data-lifecycle="start">Start</button><button class="btn" type="button" data-lifecycle="complete">Complete</button><button class="btn" type="button" data-lifecycle="reopen">Reopen</button></div></section><section class="sb__sect"><div class="sb__sh"><span class="sb__k">Assignee</span></div><div class="readstate" data-outcome="ready"><select class="input" aria-label="Assignee"><option value="">Unassigned</option><option value="p-1">Ada</option></select></div></section><form id="task-fields" class="sb__sect taskform"><div class="sb__sh"><span class="sb__k">Details</span></div><div class="field"><label class="tf__k" for="task-title">Title</label><input id="task-title" class="input" required="" type="text" value="A task with one proposal"></div><div class="field"><label class="tf__k" for="task-due">Due date</label><input id="task-due" class="input" type="date" value="2026-10-01"></div><button class="btn btn--primary" type="submit">Save changes</button></form><section class="sb__sect" data-comments="section"><div class="sb__sh"><span class="sb__k">Comments</span><span class="sbact__meta">1 on this task</span></div><div class="thread" data-comments="list"><article class="msg msg--internal" data-comment-id="c-1" data-audience="internal"><div class="sbact__meta"><span class="sb__state" data-comment-audience="internal">Internal</span><span> · note</span><span> · p-1</span><span> · 2026-09-22T02:00:00.000Z</span></div><p class="card__body">First note</p></article></div><p class="field__error" role="alert" data-comment="refusal">SCOPE_NOT_GRANTED (task). Read the task again.</p><form id="task-comment" class="taskform"><div class="field"><label class="tf__k" for="comment-body">Say something</label><textarea id="comment-body" class="input" rows="3" required="" disabled="">Hello</textarea></div><div class="field"><label class="tf__k" for="comment-audience">Who may read it</label><select id="comment-audience" class="input" disabled=""><option value="internal">Internal — the business only</option><option value="client">Client — the client may read it</option></select></div><div class="field"><label class="tf__k" for="comment-kind">What it is</label><select id="comment-kind" class="input" disabled=""><option value="note">Note</option><option value="client">Client message</option></select></div><button class="btn btn--primary" type="submit" data-comment="post" disabled="">Post comment</button><p class="card__sub" data-comment="closed">The server refused this. The box is closed rather than asking again on your behalf.</p></form></section><section class="sb__sect" data-section="agent" aria-label="Agent"><section class="agent" data-agent="pane" data-agent-lineage="l-1"><div class="sb__sh" data-agent="proposal-header"><span class="sb__k">Proposal · client renewal quote</span><span class="btnrow"><button class="btn btn--sm btn--secondary" type="button" data-agent="reject">Reject this proposal</button></span></div><div class="sb__sh"><span class="sb__k">Current run</span><span class="sbact__meta u-mono" data-agent="run-id">not planned</span></div><p class="sbact__meta" data-agent="scope" data-scope="none">No scope has been issued on this task yet.</p><div class="trs" data-tone="gate" data-agent="summary" data-run-state="at-gate"><div class="trs__top"><span class="sbact__meta u-mono">Attempt 1 · agent</span><span class="spill" data-tone="gate" data-agent="state-word">At human gate</span></div><p class="trs__say">The agent has staged its work and is waiting on a person to decide.</p><div class="trs__grid"><div class="trs__c" data-summary="progress"><span class="tf__k">Progress</span><span class="trs__v">No checks yet</span></div><div class="trs__c" data-summary="current-job"><span class="tf__k">Current job</span><span class="trs__v">Human approval</span></div><div class="trs__c" data-summary="blocked-by"><span class="tf__k">Blocked by</span><span class="trs__v">Human approval</span></div><div class="trs__c" data-summary="next-action"><span class="tf__k">Next action</span><span class="trs__v">A person decides the gate</span></div></div></div><div class="wf" data-agent="workflow"><button class="wf__toggle" type="button" aria-expanded="false" data-agent="job-list"><span class="sb__k u-mono">View 2-job workflow</span></button><div class="wf__list" hidden=""><div class="wf__row" data-job="work" data-job-state="waiting"><span class="wf__mark" data-tone="waiting" aria-hidden="true"></span><div class="wf__body"><span class="wf__t">client renewal quote</span><span class="sbact__meta u-mono">WORK · typed output v1</span></div><span class="spill wf__state" data-tone="waiting">waiting</span></div><div class="wf__row" data-job="gate" data-job-state="pending"><span class="wf__mark" data-tone="pending" aria-hidden="true"></span><div class="wf__body"><span class="wf__t">Human approval</span><span class="sbact__meta u-mono">GATE · v1</span></div><span class="spill wf__state" data-tone="pending">pending</span></div></div></div><div class="sout" data-agent="staged"><div class="sb__sh"><span class="sb__k">Staged output</span><span class="sbact__meta">built · nothing published</span></div><p class="sout__say" data-staged="none">Nothing was staged for this version.</p><p class="sout__say">Staged only. Nothing has been applied.</p></div><div class="gatebox" data-agent="gate" data-gate-kind="armed" data-gate-id="g-1"><div class="gate gate--armed"><span class="gate__mark" aria-hidden="true"></span><div><div class="gate__word">Human approval gate</div><p class="gate__say">client renewal quote, waiting on a person with the gate’s authority.</p></div></div><div class="sout__box"><div class="sout__row" data-gate-fact="artefact"><span class="tf__k">Exact artefact</span><span class="sb__state">v1 <span class="sbact__meta u-mono" title="digest-1" data-gate="digest">digest-1</span></span></div><div class="sout__row" data-gate-fact="unlocks"><span class="tf__k">Approval unlocks</span><span class="sb__state">The run continues, within AUD 2500.00.</span></div><div class="sout__row" data-gate-fact="waits"><span class="tf__k">Why it waits</span><span class="sb__state">Nothing runs until a person decides this version.</span></div></div><div class="gatebox__acts" data-agent="gate-actions"><button class="btn btn--sm btn--secondary" type="button" data-gate-action="request_changes">Request changes</button><button class="btn btn--sm btn--primary" type="button" data-gate-action="approve">Approve exact v1</button></div></div></section></section><section class="sb__sect" data-proposals="section"><div class="sb__sh"><span class="sb__k">Proposals</span><span class="sbact__meta">1 on this task</span></div><div class="stack" data-proposals="list"><article class="sb__sect" data-lineage-id="l-1" data-lineage-state="live"><div class="sb__sh"><span class="sb__k">Lineage</span><span class="sb__state">live</span><span class="sbact__meta">l-1</span><button class="btn" data-lineage-action="reject" data-reject-gate="g-1" data-reject-version="v-1" type="button">Reject this proposal</button></div><div class="sb__sect" data-version="1" data-version-id="v-1" data-version-superseded="false"><div class="sb__sh"><span class="sb__k">Version 1</span><span class="sb__state">client_renewal_quote</span><span class="sbact__meta" data-version="ceiling">up to AUD 2,500.00</span></div><div class="card__sub"><span data-version="digest">payload digest digest-1</span></div><pre class="card__body" data-version="payload">{
  "step": "draft the quote"
}</pre><p class="card__sub" data-evidence="none">No evidence pack was stored against this version.</p><div class="card__sub" data-gate-expired="false" data-gate-state="pending">Gate pending, round 1<span> · expires 2026-09-23T05:00:00.000Z</span></div><div class="btnrow" data-decide="controls"><button class="btn" data-decide="request_changes" data-gate-id="g-1" data-version-id="v-1" type="button">Request changes</button><button class="btn btn--primary" data-decide="approve" data-gate-id="g-1" data-version-id="v-1" type="button">Approve this version</button><p class="card__sub" data-gate="notice">This demonstration changes nothing outside the app: its one effect is a team-only comment on this task.</p></div></div></article></div><form class="taskform" id="task-propose"><div class="sb__sh"><span class="sb__k">Propose something</span></div><div class="field"><label class="tf__k" for="propose-purpose">What it is for</label><input class="input" id="propose-purpose" pattern="[a-z][a-z0-9_]{0,62}" required="" title="Lower case, digits and underscores, starting with a letter." type="text" value=""><p class="card__sub">Lower case, digits and underscores, such as client_renewal_quote.</p></div><div class="field"><label class="tf__k" for="propose-maximum">The most it may spend</label><input class="input" id="propose-maximum" min="0" required="" step="0.01" type="number" value=""></div><div class="field"><label class="tf__k" for="propose-currency">In</label><select class="input" id="propose-currency"><option value="AUD">AUD</option></select></div><button class="btn btn--primary" data-propose="submit" type="submit">Propose</button></form></section><section class="sb__sect" data-outcome="denied" data-run-progress=""><div class="sb__sh"><span class="sb__k">The run</span></div><p class="card__sub" data-run="denied">The server refused this read (NOT_FOUND), so nothing about the run is shown.</p></section><section class="sb__sect"><div class="sb__sh"><span class="sb__k">History</span></div><div class="sbact"><div class="sbact__row"><span class="sbact__meta">2026-09-22T01:00:00.000Z · p-1</span><span class="sb__state">task.create</span></div></div></section></div></div></div>"
`;

