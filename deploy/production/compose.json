{
  "name": "ops-astro",
  "x-ops-astro": {
    "ownPrefix": "ops-astro",
    "productionDatabaseMajor": 17,
    "artefact": "ops-astro-{version}",
    "madeUpDataOnly": false
  },
  "services": {
    "backups": {
      "container_name": "ops-astro-backups",
      "image": "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24",
      "environment": {
        "POSTGRES_DB": "ops_astro_backups",
        "POSTGRES_USER": "${PRODUCTION_BACKUPS_ADMIN_USER:?set from the restore runbook}",
        "POSTGRES_PASSWORD": "${PRODUCTION_BACKUPS_ADMIN_PASSWORD:?set from the restore runbook}"
      },
      "command": [
        "postgres",
        "-c",
        "ssl=on",
        "-c",
        "ssl_cert_file=/etc/ops-astro-tls/server.crt",
        "-c",
        "ssl_key_file=/etc/ops-astro-tls/server.key",
        "-c",
        "log_min_error_statement=panic"
      ],
      "volumes": [
        "ops-astro-backups-data:/var/lib/postgresql/data",
        "ops-astro-tls:/etc/ops-astro-tls:ro"
      ],
      "networks": ["production"],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "${PRODUCTION_BACKUPS_ADMIN_USER}",
          "-d",
          "ops_astro_backups"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20
      },
      "user": "70:70",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "tmpfs": [
        "/var/run/postgresql:size=1m,uid=70,gid=70,mode=0775",
        "/tmp:size=64m,uid=70,gid=70,mode=1777"
      ],
      "cpus": "0.5",
      "mem_limit": "512m",
      "memswap_limit": "512m",
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "forwarder": {
      "container_name": "ops-astro-forwarder",
      "image": "node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1",
      "working_dir": "/app",
      "command": ["node", "scripts/ops/forwarder.mjs"],
      "environment": {
        "DATABASE_FORWARDER_URL": "${PRODUCTION_FORWARDER_DATABASE_URL:?set from the production runbook}",
        "OPS_ERROR_SINK_DSN": "${PRODUCTION_ERROR_SINK_DSN:?set from the production runbook}",
        "OPS_ENVIRONMENT": "production",
        "OPS_RELEASE": "${PRODUCTION_RELEASE:?set from the production runbook}",
        "OPS_FORWARDER_HEARTBEAT_URL": "${PRODUCTION_FORWARDER_HEARTBEAT_URL:?set from the production runbook}",
        "OPS_SINK_HEARTBEAT_URL": "${PRODUCTION_SINK_HEARTBEAT_URL:?set from the production runbook}",
        "OPS_HEARTBEAT_EVERY_MS": "${PRODUCTION_HEARTBEAT_EVERY_MS:?set from the production runbook}",
        "OPS_EGRESS_POOLER_HOST": "${PRODUCTION_EGRESS_POOLER_HOST:?set from the production runbook}",
        "OPS_EGRESS_POOLER_PORT": "${PRODUCTION_EGRESS_POOLER_PORT:?set from the production runbook}",
        "OPS_EGRESS_HEARTBEAT_HOST": "${PRODUCTION_EGRESS_HEARTBEAT_HOST:?set from the production runbook}",
        "OPS_EGRESS_SINK_HOST": "${PRODUCTION_EGRESS_SINK_HOST:?set from the production runbook}"
      },
      "volumes": ["ops-astro-app:/app:ro"],
      "networks": ["production"],
      "restart": "unless-stopped",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "tmpfs": ["/tmp:size=16m,uid=1000,gid=1000,mode=1777"],
      "cpus": "0.5",
      "mem_limit": "256m",
      "memswap_limit": "256m",
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "egress": {
      "container_name": "ops-astro-egress",
      "image": "node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1",
      "working_dir": "/app",
      "command": ["node", "scripts/ops/egress.mjs", "relay"],
      "environment": {
        "OPS_ASTRO_API_URL": "${PRODUCTION_WEB_URL:?set from the production runbook}",
        "OPS_EGRESS_API_ALIAS": "${PRODUCTION_EGRESS_API_HOST:?set from the production runbook}",
        "OPS_EGRESS_POOLER_HOST": "${PRODUCTION_EGRESS_POOLER_HOST:?set from the production runbook}",
        "OPS_EGRESS_POOLER_PORT": "${PRODUCTION_EGRESS_POOLER_PORT:?set from the production runbook}",
        "OPS_EGRESS_HEARTBEAT_HOST": "${PRODUCTION_EGRESS_HEARTBEAT_HOST:?set from the production runbook}",
        "OPS_EGRESS_SINK_HOST": "${PRODUCTION_EGRESS_SINK_HOST:?set from the production runbook}",
        "OPS_EGRESS_AUTH_HOST": "${PRODUCTION_EGRESS_AUTH_HOST:?set from the production runbook}",
        "OPS_EGRESS_OUT": "egress-out"
      },
      "volumes": ["ops-astro-app:/app:ro"],
      "restart": "unless-stopped",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "tmpfs": ["/tmp:size=16m,uid=1000,gid=1000,mode=1777"],
      "cpus": "0.5",
      "mem_limit": "256m",
      "memswap_limit": "256m",
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "networks": {
        "production": {
          "aliases": [
            "${PRODUCTION_EGRESS_API_HOST:?set from the production runbook}",
            "${PRODUCTION_EGRESS_POOLER_HOST:?set from the production runbook}",
            "${PRODUCTION_EGRESS_HEARTBEAT_HOST:?set from the production runbook}",
            "${PRODUCTION_EGRESS_SINK_HOST:?set from the production runbook}",
            "${PRODUCTION_EGRESS_AUTH_HOST:?set from the production runbook}"
          ]
        },
        "egress-link": {}
      }
    },
    "egress-out": {
      "container_name": "ops-astro-egress-out",
      "image": "node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1",
      "working_dir": "/app",
      "command": ["node", "scripts/ops/egress.mjs", "out"],
      "environment": {
        "OPS_ASTRO_API_URL": "${PRODUCTION_WEB_URL:?set from the production runbook}",
        "OPS_EGRESS_POOLER_HOST": "${PRODUCTION_EGRESS_POOLER_HOST:?set from the production runbook}",
        "OPS_EGRESS_POOLER_PORT": "${PRODUCTION_EGRESS_POOLER_PORT:?set from the production runbook}",
        "OPS_EGRESS_HEARTBEAT_HOST": "${PRODUCTION_EGRESS_HEARTBEAT_HOST:?set from the production runbook}",
        "OPS_EGRESS_SINK_HOST": "${PRODUCTION_EGRESS_SINK_HOST:?set from the production runbook}",
        "OPS_EGRESS_AUTH_HOST": "${PRODUCTION_EGRESS_AUTH_HOST:?set from the production runbook}"
      },
      "volumes": ["ops-astro-app:/app:ro"],
      "restart": "unless-stopped",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "tmpfs": ["/tmp:size=16m,uid=1000,gid=1000,mode=1777"],
      "cpus": "0.5",
      "mem_limit": "256m",
      "memswap_limit": "256m",
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "networks": ["egress-link", "egress"]
    }
  },
  "networks": {
    "production": {
      "name": "ops-astro",
      "internal": true,
      "enable_ipv6": false,
      "driver_opts": {
        "com.docker.network.bridge.gateway_mode_ipv4": "isolated"
      }
    },
    "egress-link": {
      "name": "ops-astro-egress-link",
      "internal": true,
      "enable_ipv6": false,
      "driver_opts": {
        "com.docker.network.bridge.gateway_mode_ipv4": "isolated"
      }
    },
    "egress": {
      "name": "ops-astro-egress",
      "internal": false,
      "enable_ipv6": false
    }
  },
  "volumes": {
    "ops-astro-backups-data": {
      "name": "ops-astro-backups-data"
    },
    "ops-astro-tls": {
      "name": "ops-astro-tls"
    },
    "ops-astro-app": {
      "name": "ops-astro-app"
    }
  }
}
