# Staged settings only. Applying these to a running API requires owner approval.
# See docs/local/LANGFUSE.md. Supply owner-only files before activation.
# The M5's trace export process (apps/trace-export/main.ts) reads this file,
# kept 0600, through TRACE_EXPORT_SETTINGS_FILE. Off, it reads nothing else.
TRACE_EXPORT=off
TRACE_EXPORT_ORIGIN=http://127.0.0.1:3400
TRACE_EXPORT_CREDENTIALS_FILE=
TRACE_EXPORT_KEY_FILE=
DATABASE_TRACE_URL=
TRACE_EXPORT_BUSINESSES=
