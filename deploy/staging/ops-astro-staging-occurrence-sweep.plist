<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ops-astro-staging-occurrence-sweep</string>
  <key>WorkingDirectory</key>
  <string>@STAGING_REPO_DIR@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>--env-file=@STAGING_SWEEP_ENV_FILE@</string>
    <string>apps/automations/sweep.ts</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@STAGING_PATH@</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>@STAGING_SWEEP_LOG@</string>
  <key>StandardErrorPath</key>
  <string>@STAGING_SWEEP_LOG@</string>
</dict>
</plist>
