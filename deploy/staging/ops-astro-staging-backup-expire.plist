<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Staging's backup retention, as the retention identity (ticket S0-3). The @...@ values come from the private staging runbook. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ops-astro-staging-backup-expire</string>
  <key>WorkingDirectory</key>
  <string>@STAGING_REPO_DIR@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>--env-file=@STAGING_RETENTION_ENV_FILE@</string>
    <string>scripts/ops/backup.mjs</string>
    <string>expire</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@STAGING_PATH@</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>@STAGING_BACKUP_LOG@</string>
</dict>
</plist>
